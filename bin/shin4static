#!/bin/sh
# Shin4Static: user-list routing through VPN with per-entry kill switch.

# Entware first: the firmware has no readlink/dirname, and callers such as
# the web CGI may give us no PATH at all.
export PATH=/opt/bin:/opt/sbin:${PATH:-/sbin:/bin:/usr/sbin:/usr/bin}

_self=$(readlink -f "$0")
_base=$(dirname "$(dirname "$_self")")
S4S_LIB=${S4S_LIB:-$_base/lib}

. "$S4S_LIB/common.sh"
. "$S4S_LIB/resolve.sh"
. "$S4S_LIB/generate.sh"
. "$S4S_LIB/apply.sh"

usage() {
	cat <<'EOF'
Использование: shin4static <команда> [-q] [-v]

  update        обновить маршруты (запускается из cron раз в час)
  check         проверить списки и показать результат, ничего не меняя
  status        состояние интерфейсов, правил и таблиц
  why <IP>      какой записью и по какой цепочке идёт адрес
  rules start|stop
                добавить или убрать правила ip rule
  daemon start|stop
                запустить или остановить свой экземпляр BIRD
  flush         удалить маршруты Shin4Static из таблиц ядра

  -q  только ошибки и предупреждения
  -v  подробно
EOF
}

rule_pairs() {
	echo "$PRIO_STEP1 $TABLE_STEP1"
	echo "$PRIO_STEP2 $TABLE_STEP2"
	echo "$PRIO_KS $TABLE_KS"
}

# Pairs set up last time: after TABLE_*/PRIO_* change in the config the old
# rules and routes (kept by persist) must go too.
APPLIED=$S4S_STATE/applied
all_pairs() {
	{ rule_pairs; cat "$APPLIED" 2>/dev/null; } | sort -u
}

rules_start() {
	if [ -s "$APPLIED" ]; then
		while read -r _prio _table; do
			rule_pairs | grep -qx "$_prio $_table" && continue
			info "номера изменились: убираю правило $_prio и таблицу $_table"
			while "$IP" rule del table "$_table" priority "$_prio" 2>/dev/null; do :; done
			"$IP" route flush table "$_table" 2>/dev/null
		done < "$APPLIED"
	fi
	rule_pairs > "$APPLIED"
	rule_pairs | while read -r _prio _table; do
		_have=$("$IP" rule show | awk -v p="$_prio:" '$1 == p')
		if [ -z "$_have" ]; then
			"$IP" rule add table "$_table" priority "$_prio"
		elif ! printf '%s\n' "$_have" | grep -qw "lookup $_table"; then
			warn "приоритет $_prio уже занят другим правилом: $_have"
		fi
	done
}

rules_stop() {
	all_pairs | while read -r _prio _table; do
		while "$IP" rule del table "$_table" priority "$_prio" 2>/dev/null; do :; done
	done
}

# Routes are kept in the kernel when BIRD stops (persist); remove them.
routes_flush() {
	all_pairs | while read -r _prio _table; do
		"$IP" route flush table "$_table" 2>/dev/null
	done
	rm -f "$APPLIED"
}

cmd_update() {
	lock_acquire
	WORK=$(mktemp -d /tmp/shin4static.XXXXXX) || die "не удалось создать временный каталог"
	[ "$DRY_RUN" = 1 ] || : > "$S4S_LOG"
	generate "$WORK/gen"

	if [ "$DRY_RUN" = 1 ]; then
		for _g in "$WORK"/grp/*; do
			case "$_g" in *.raw) continue ;; esac
			[ -e "$_g" ] || continue
			_key=$(basename "$_g")
			printf '%s: %s сетей из %s записей\n' "$(describe_group "$_key")" \
				"$(grep -c . "$_g")" "$(cat "$WORK/in/$_key.n" 2>/dev/null || echo 0)"
		done
	else
		# Lost rules or a crashed BIRD would quietly send everything,
		# kill switch included, through the provider: repair them here.
		rules_start
		if ! bird_running; then
			warn "BIRD Shin4Static не работал — запускаю"
			(daemon_start)
		fi
		apply_generated "$WORK/gen" && save_groups
	fi

	[ "$ERRORS$WARNINGS" = 00 ] || info "ошибок: $ERRORS, предупреждений: $WARNINGS"
	[ "$ERRORS" = 0 ]
}

cmd_status() {
	echo "Интерфейсы:"
	for _x in isp 1 2; do
		_if=$(exit_iface "$_x")
		[ -n "$_if" ] || continue
		_st=$("$IP" -o link show dev "$_if" 2>/dev/null | sed -n 's/.*<\([^>]*\)>.*/\1/p')
		printf '  %s: %s\n' "$(exit_name "$_x")" "${_st:-нет такого интерфейса}"
	done
	echo "Правила и таблицы:"
	rule_pairs | while read -r _prio _table; do
		_rule=$("$IP" rule show | awk -v p="$_prio:" '$1 == p')
		_cnt=$("$IP" route show table "$_table" 2>/dev/null | grep -c .)
		printf '  %s → таблица %s: %s, маршрутов: %s\n' "$_prio" "$_table" \
			"$([ -n "$_rule" ] && echo 'правило есть' || echo 'ПРАВИЛА НЕТ')" "$_cnt"
	done
	# Rules checked before ours (Bird4Static, Keenetic policies) decide first:
	# an address they catch never reaches our tables or the kill switch.
	_before=$("$IP" rule show 2>/dev/null | awk -v p="$PRIO_STEP1" '
		{ n = $1; sub(/:$/, "", n) }
		n + 0 < p + 0 && / lookup / && !/ lookup (local|main|default)( |$)/')
	if [ -n "$_before" ]; then
		echo "Правила, которые проверяются раньше наших (их адреса не попадут в списки и kill switch):"
		printf '%s\n' "$_before" | sed 's/^/  /'
	fi
	if bird_running; then
		echo "BIRD Shin4Static (pid $(cat "$S4S_PIDFILE" 2>/dev/null)):"
		s4s_birdc show protocols 2>/dev/null | grep 's4s_' | sed 's/^/  /'
	else
		echo "BIRD Shin4Static: НЕ ЗАПУЩЕН (маршруты в ядре сохранены, но не обновляются)"
	fi
	if [ -s "$S4S_LOG" ]; then
		echo "Последний запуск:"
		sed 's/^/  /' "$S4S_LOG" | tail -15
	fi
}

# Exit name for "через …": провайдера (eth3), VPN1 (nwg0).
via_name() {
	case "$1" in
		isp) echo "провайдера ($ISP)" ;;
		*) echo "VPN$1 ($(exit_iface "$1"))" ;;
	esac
}

# The path a group key promises, as a sentence.
describe_path() {
	_p=${1%%.*}
	_m=${1#*.}
	_n=${_m#?}
	_m=${_m%?}
	_first=$(via_name "$_p")
	case "$_m" in
		N) if [ "$_p" = isp ]; then
				echo "через $_first"
			else
				echo "через $_first; если он недоступен — через провайдера"
			fi ;;
		K) if [ "$_n" = 0 ]; then
				echo "только через $_first; если он недоступен — блок (kill switch)"
			else
				echo "через $_first; если он недоступен — через $(via_name "$_n"); если и он недоступен — блок (kill switch)"
			fi ;;
		F) echo "через $_first; если он недоступен — через $(via_name "$_n"); если и он недоступен — через провайдера" ;;
	esac
}

# Interface name -> "VPN1 (nwg0)" etc.
dev_name() {
	case "$1" in
		"$VPN1") via_name 1 ;;
		"$VPN2") [ -n "$VPN2" ] && via_name 2 || echo "$1" ;;
		"$ISP") via_name isp ;;
		*) echo "$1" ;;
	esac
}

# List entries containing the address, from the lists as they are now:
# "<group>\t<file:line>\t<on|off>" per entry; off - disabled ("#off ...").
# Domains and AS are checked against the addresses and prefixes the last
# update got for them.
find_entries() {
	parse_lists 2>/dev/null | grep '^R	' | sed 's/$/	on/' > "$WORK/records"
	# Disabled entries: the same files with only the "#off" lines, uncommented,
	# so that line numbers stay.
	mkdir -p "$WORK/off"
	for _f in "$S4S_LISTS"/*.list; do
		[ -f "$_f" ] || continue
		sed -e 's/^[[:blank:]]*#[Oo][Ff][Ff][[:blank:]][[:blank:]]*//;t' -e 's/.*//' "$_f" > "$WORK/off/${_f##*/}"
	done
	parse_lists "$WORK/off" 2>/dev/null | grep '^R	' | sed 's/$/	off/' >> "$WORK/records"
	printf '%s\n' "$1" > "$WORK/ip"
	while IFS='	' read -r _t _key _kind _val _where _state; do
		case "$_kind" in
			ip|range) printf '%s\n' "$_val" > "$WORK/v"; _src=$WORK/v ;;
			domain) _src=$S4S_STATE/dns/$_val ;;
			asn) _src=$S4S_STATE/asn/$_val ;;
			*) continue ;;
		esac
		[ -s "$_src" ] || continue
		[ -n "$("$IPRANGE" --common "$_src" "$WORK/ip" 2>/dev/null)" ] && printf '%s\t%s\t%s\n' "$_key" "$_where" "$_state"
	done < "$WORK/records"
}

# Text of the line file:line in the lists.
entry_text() {
	sed -n "${1##*:}p" "$S4S_LISTS/${1%:*}" | tr -d '\r' | sed 's/^[[:blank:]]*//; s/[[:blank:]]*$//'
}

cmd_why() {
	_ip=$1
	case "$_ip" in
		*[!0-9.]*|'') die "укажите IPv4-адрес" ;;
	esac
	WORK=$(mktemp -d /tmp/shin4static.XXXXXX) || die "не удалось создать временный каталог"
	trap 'rm -rf "$WORK"' EXIT
	# Read-only: keep the log of the last update as it is.
	DRY_RUN=1

	# The group the address belongs to in the routes applied now: after
	# overlaps it is at most one.
	_group=
	for _g in "$S4S_STATE"/groups/*; do
		[ -s "$_g" ] || continue
		if [ -n "$(printf '%s\n' "$_ip" | "$IPRANGE" --common - "$_g" 2>/dev/null)" ]; then
			_group=$(basename "$_g")
			break
		fi
	done
	find_entries "$_ip" > "$WORK/found"
	grep '	on$' "$WORK/found" > "$WORK/active"

	echo "Адрес $_ip"
	if [ -s "$WORK/found" ]; then
		[ "$(grep -c . "$WORK/found")" = 1 ] && echo "Запись в списке:" || echo "Записи в списках:"
		while IFS='	' read -r _key _where _state; do
			_note=
			if [ "$_state" = off ]; then
				_note="  — отключена, не действует"
			elif [ -n "$_group" ] && [ "$_key" != "$_group" ] && grep -q "^$_group	" "$WORK/active"; then
				_note="  — не действует: адрес забрала более строгая запись"
			fi
			printf '  %s  %s%s\n' "$_where" "$(entry_text "$_where")" "$_note"
		done < "$WORK/found"
	fi
	if [ ! -s "$WORK/found" ]; then
		echo "В списках нет: обычная маршрутизация, через провайдера."
	elif [ ! -s "$WORK/active" ]; then
		echo "Действующих записей нет: обычная маршрутизация, через провайдера."
	fi
	if [ -n "$_group" ]; then
		echo "Путь по записи: $(describe_path "$_group")."
		grep -q "^$_group	" "$WORK/active" ||
			echo "Внимание: применённые маршруты не совпадают со списками — нажмите «Применить» (shin4static update)."
	elif [ -s "$WORK/active" ]; then
		echo "Внимание: запись есть, но ещё не применена — нажмите «Применить» (shin4static update)."
	fi

	# What the kernel does right now.
	_route=$("$IP" route get "$_ip" 2>&1 | head -1)
	_dev=$(printf '%s\n' "$_route" | sed -n 's/.* dev \([^ ]*\).*/\1/p')
	_table=$(printf '%s\n' "$_route" | sed -n 's/.* table \([^ ]*\).*/\1/p')
	case "$_route" in
		*nreachable*|*prohibit*|*blackhole*) _table=$TABLE_KS ;;
	esac
	case "$_table" in
		"$TABLE_STEP1") _now="через $(dev_name "$_dev") — основной путь" ;;
		"$TABLE_STEP2") _now="через $(dev_name "$_dev") — резервный путь, основной выход недоступен" ;;
		"$TABLE_KS") _now="заблокирован (kill switch): все выходы этой записи недоступны" ;;
		''|main|254)
			if [ -z "$_dev" ]; then
				_now="ядро не нашло маршрут: $_route"
			elif [ -n "$_group" ] && [ "${_group%%.*}" != isp ]; then
				_now="через $(dev_name "$_dev") — VPN этой записи недоступен, обычная маршрутизация"
			else
				_now="через $(dev_name "$_dev") — обычная маршрутизация"
			fi ;;
		*)
			_rule=$("$IP" rule show 2>/dev/null | grep -E "lookup $_table( |\$)" | head -1)
			_now="через $(dev_name "$_dev") по чужому правилу (таблица $_table), оно проверяется раньше наших: ${_rule:-см. ip rule}" ;;
	esac
	echo "Сейчас: $_now."
	echo "Для диагностики: $_route"
}

DRY_RUN=0
_cmd=$1
[ $# -gt 0 ] && shift
_arg=
for _o in "$@"; do
	case "$_o" in
		-q) QUIET=1 ;;
		-v) VERBOSE=1 ;;
		*) _arg=$_o ;;
	esac
done

case "$_cmd" in
	update) load_config; cmd_update ;;
	check) load_config; DRY_RUN=1; cmd_update ;;
	status) load_config; cmd_status ;;
	why) load_config; cmd_why "$_arg" ;;
	# Stopping and cleaning up work with a broken config too (uninstall).
	rules)
		case "$_arg" in
			start) load_config; rules_start ;;
			stop) load_config lenient; rules_stop ;;
			*) usage; exit 1 ;;
		esac ;;
	daemon)
		case "$_arg" in
			start) load_config; daemon_start ;;
			stop) load_config lenient; daemon_stop ;;
			*) usage; exit 1 ;;
		esac ;;
	flush) load_config lenient; routes_flush ;;
	*) usage; exit 1 ;;
esac
