#!/bin/sh
# Shin4Static web API (CGI). Read-only actions are GET, changing ones are POST
# and need the session token, which other sites cannot read.
#
#   GET  ?a=token                  token for POST requests
#   GET  ?a=info                   ISP/VPN1/VPN2 interface names, WEB_AUTH
#   GET  ?a=get&name=vpn1.list     list file contents
#   GET  ?a=status                 shin4static status
#   GET  ?a=why&ip=1.2.3.4         shin4static why
#   POST ?a=save&name=…&base=MD5&t=TOKEN
#                                  body = new list contents; base = md5 of the
#                                  text the page loaded (refused if changed)
#   POST ?a=check&t=TOKEN          shin4static check
#   POST ?a=apply&t=TOKEN          shin4static update
#
# With WEB_AUTH=router (password of the router's web interface):
#   GET  ?a=challenge              "id\nrealm\nchallenge" from the router
#   POST ?a=login                  body = "login\nid\nsha256(challenge + md5(login:realm:password))",
#                                  sets a session cookie; the password never leaves the browser
#   POST ?a=logout&t=TOKEN
# Every other action then needs the session; without it the answer is
# X-S4S-Result: auth. With WEB_AUTH=local lighttpd asks for its own password.
#
# The mode is the one S81shin4static-web started lighttpd with (web.mode),
# not the current config: the two must never disagree.

# Exported: lighttpd starts us with no PATH at all.
export PATH=/opt/bin:/opt/sbin:/sbin:/bin:/usr/sbin:/usr/bin
S4S_ROOT=${S4S_ROOT:-/opt}
S4S_BIN=${S4S_BIN:-shin4static}
CURL=${CURL:-curl}
LISTS=$S4S_ROOT/etc/shin4static/lists
CONF=$S4S_ROOT/etc/shin4static/shin4static.conf
STATE=$S4S_ROOT/var/shin4static
TOKEN_FILE=$STATE/web.token
MODE_FILE=$STATE/web.mode
SESSIONS=$STATE/web-sessions
PENDING=$STATE/web-login
LOGIN_FAILS=$STATE/web-login.fails
MAX_BODY=262144
COOKIE=s4s_session
HEADERS=

reply() {
	printf 'Content-Type: text/plain; charset=utf-8\r\n'
	printf 'Cache-Control: no-store\r\n'
	printf 'X-Content-Type-Options: nosniff\r\n'
	[ -n "$HEADERS" ] && printf '%s\r\n' "$HEADERS"
	printf 'X-S4S-Result: %s\r\n\r\n' "$1"
}

fail() {
	reply error
	printf '%s\n' "$1"
	exit 0
}

param() {
	printf '%s' "$QUERY_STRING" | tr '&' '\n' | sed -n "s/^$1=//p" | head -1
}

run_s4s() {
	_out=$("$S4S_BIN" "$@" 2>&1)
	if [ $? = 0 ]; then reply ok; else reply error; fi
	printf '%s\n' "$_out"
}

# A setting as the shell sees it, the same way S81shin4static-web and
# shin4static read the file (quotes, comments and spaces included).
conf_value() {
	[ -f "$CONF" ] || return 0
	(. "$CONF" >/dev/null 2>&1; eval "printf '%s' \"\${$1-}\"")
}

# Seconds since the file was last modified.
age() {
	echo $(($(date +%s) - $(date -r "$1" +%s 2>/dev/null || echo 0)))
}

# Is IPv4 $1 inside one of the space separated CIDRs in $2?
ip_in() {
	awk -v ip="$1" -v nets="$2" '
		function num(s, a) { split(s, a, "."); return ((a[1] * 256 + a[2]) * 256 + a[3]) * 256 + a[4] }
		BEGIN {
			if (ip !~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/) exit 1
			x = num(ip)
			c = split(nets, list, " ")
			for (i = 1; i <= c; i++) {
				split(list[i], p, "/")
				size = 2 ^ (32 - (p[2] == "" ? 32 : p[2]))
				if (int(x / size) == int(num(p[1]) / size)) exit 0
			}
			exit 1
		}'
}

# Clients: localhost and WEB_ALLOW only (e.g. not the guest network).
ip_in "$REMOTE_ADDR" "127.0.0.1 $(conf_value WEB_ALLOW)" || fail "доступ с адреса ${REMOTE_ADDR:-?} запрещён (WEB_ALLOW в shin4static.conf)"

# DNS rebinding guard: the Host header must be an IP or an allowed name.
WEB_HOSTS=$(conf_value WEB_HOSTS)
_host=${HTTP_HOST%:*}
if [ -n "$_host" ]; then
	case "$_host" in
		*[!0-9.]*)
			case " $WEB_HOSTS localhost " in
				*" $_host "*) ;;
				*) fail "имя $_host не разрешено (WEB_HOSTS в shin4static.conf)" ;;
			esac ;;
	esac
fi

# Changing requests only from our own page. Browsers send Origin with every
# POST and Sec-Fetch-Site with every request, so a page of another site that
# posts here (the login form included) is refused.
if [ "$REQUEST_METHOD" = POST ]; then
	case "${HTTP_SEC_FETCH_SITE:-same-origin}" in
		same-origin) ;;
		*) fail "запрос с чужого сайта отклонён" ;;
	esac
	case "$HTTP_ORIGIN" in
		''|"http://$HTTP_HOST"|"https://$HTTP_HOST") ;;
		*) fail "запрос с чужого сайта отклонён" ;;
	esac
fi

WEB_AUTH=$(cat "$MODE_FILE" 2>/dev/null)
case "$WEB_AUTH" in
	router) ;;
	local) [ -n "$REMOTE_USER" ] || fail "lighttpd не проверил пароль: перезапустите /opt/etc/init.d/S81shin4static-web" ;;
	*) fail "веб-интерфейс запущен не через S81shin4static-web: перезапустите его" ;;
esac

# 32 random hex chars. The kernel's uuid needs no tools (Keenetic's busybox
# has no od); od is the fallback.
random_hex() {
	_r=$(tr -d '-' < /proc/sys/kernel/random/uuid 2>/dev/null)
	[ ${#_r} = 32 ] || _r=$(head -c 16 /dev/urandom 2>/dev/null | od -An -tx1 2>/dev/null | tr -d ' \n')
	printf '%s' "$_r"
}

TOKEN=
[ -f "$TOKEN_FILE" ] && TOKEN=$(cat "$TOKEN_FILE")
if [ ${#TOKEN} != 32 ]; then
	mkdir -p "$STATE"
	TOKEN=$(random_hex)
	[ ${#TOKEN} = 32 ] || fail "не удалось получить случайное значение для токена"
	printf '%s' "$TOKEN" > "$TOKEN_FILE"
fi

router_url() {
	_url=$(conf_value ROUTER_URL)
	[ -n "$_url" ] || _url="http://$(conf_value WEB_LISTEN | sed 's/:.*//')"
	printf '%s' "$_url"
}

# Lock dir $1, taking over one left by a dead CGI after $2 seconds.
# Returns 1 if somebody else holds it.
lock_dir() {
	mkdir "$1" 2>/dev/null && return 0
	[ "$(age "$1")" -ge "$2" ] || return 1
	rm -rf "$1"
	mkdir "$1" 2>/dev/null
}

# After 3 wrong passwords every attempt waits 30 s more (at most 10 min),
# for all clients together: parallel requests do not help guessing.
login_wait() {
	_n=$(cat "$LOGIN_FAILS" 2>/dev/null)
	case "$_n" in ''|*[!0-9]*) _n=0 ;; esac
	[ "$_n" -ge 3 ] || { echo 0; return; }
	_d=$(((_n - 2) * 30))
	[ "$_d" -le 600 ] || _d=600
	_d=$((_d - $(age "$LOGIN_FAILS")))
	[ "$_d" -gt 0 ] || _d=0
	echo "$_d"
}

session_id() {
	printf '%s' "$HTTP_COOKIE" | tr ';' '\n' | sed -n "s/^ *$COOKIE=\([0-9a-f]\{32\}\)$/\1/p" | head -1
}

# Valid if the session file exists and was used within WEB_SESSION_TTL.
session_valid() {
	_sid=$(session_id)
	[ -n "$_sid" ] && [ -f "$SESSIONS/$_sid" ] || return 1
	_ttl=$(conf_value WEB_SESSION_TTL)
	case "$_ttl" in ''|*[!0-9]*) _ttl=43200 ;; esac
	if [ "$(age "$SESSIONS/$_sid")" -ge "$_ttl" ]; then
		rm -f "$SESSIONS/$_sid"
		return 1
	fi
	touch "$SESSIONS/$_sid"
}

_a=$(param a)

if [ "$WEB_AUTH" = router ]; then
	# Step 1: the router's challenge. Its cookie jar stays here under a
	# one-time id; the browser computes the answer itself.
	if [ "$_a" = challenge ]; then
		mkdir -p "$PENDING"
		for _j in "$PENDING"/*; do
			[ -f "$_j" ] && [ "$(age "$_j")" -ge 120 ] && rm -f "$_j"
		done
		_id=$(random_hex)
		[ ${#_id} = 32 ] || fail "не удалось получить случайное значение"
		_hdr=$("$CURL" -s -m 10 -c "$PENDING/$_id" -D - -o /dev/null "$(router_url)/auth" | tr -d '\r')
		_realm=$(printf '%s\n' "$_hdr" | sed -n 's/^[Xx]-[Nn][Dd][Mm]-[Rr][Ee][Aa][Ll][Mm]: *//p' | head -1)
		_chal=$(printf '%s\n' "$_hdr" | sed -n 's/^[Xx]-[Nn][Dd][Mm]-[Cc][Hh][Aa][Ll][Ll][Ee][Nn][Gg][Ee]: *//p' | head -1)
		if [ -z "$_realm" ] || [ -z "$_chal" ]; then
			rm -f "$PENDING/$_id"
			fail "роутер не ответил на проверку пароля (ROUTER_URL в shin4static.conf)"
		fi
		touch "$PENDING/$_id"
		reply ok
		printf '%s\n%s\n%s\n' "$_id" "$_realm" "$_chal"
		exit 0
	fi
	# Step 2: pass the browser's answer to the router.
	if [ "$_a" = login ]; then
		[ "$REQUEST_METHOD" = POST ] || fail "вход только через POST"
		case "$CONTENT_LENGTH" in ''|*[!0-9]*) fail "нет данных" ;; esac
		[ "$CONTENT_LENGTH" -le 1024 ] || fail "слишком длинные данные"
		_body=$(head -c "$CONTENT_LENGTH" | tr -d '\r')
		_user=$(printf '%s\n' "$_body" | sed -n 1p)
		_id=$(printf '%s\n' "$_body" | sed -n 2p)
		_hash=$(printf '%s\n' "$_body" | sed -n 3p)
		case "$_id" in *[!0-9a-f]*) _id= ;; esac
		[ ${#_id} = 32 ] && [ -f "$PENDING/$_id" ] && [ "$(age "$PENDING/$_id")" -lt 120 ] ||
			fail "вход устарел: попробуйте ещё раз"
		# One attempt at a time for everybody, and each challenge only once.
		lock_dir "$PENDING.lock" 30 || { rm -f "$PENDING/$_id"; fail "идёт другая попытка входа, повторите"; }
		_jar=$PENDING/$_id.used
		trap 'rm -f "$_jar"; rmdir "$PENDING.lock" 2>/dev/null' EXIT
		mv "$PENDING/$_id" "$_jar" 2>/dev/null || fail "вход устарел: попробуйте ещё раз"
		_wait=$(login_wait)
		[ "$_wait" = 0 ] || fail "слишком много неверных паролей: подождите $_wait с"
		_users=$(conf_value WEB_USERS)
		case "$_user" in ''|*[!A-Za-z0-9_.-]*) _user= ;; esac
		case " ${_users:-admin} " in
			*" $_user "*) ;;
			*) _user= ;;
		esac
		case "$_hash" in *[!0-9a-f]*) _hash= ;; esac
		_code=
		if [ -n "$_user" ] && [ ${#_hash} = 64 ]; then
			_code=$(printf '{"login":"%s","password":"%s"}' "$_user" "$_hash" |
				"$CURL" -s -m 10 -b "$_jar" -c "$_jar" -o /dev/null -w '%{http_code}' \
					-H 'Content-Type: application/json' --data-binary @- "$(router_url)/auth")
		else
			_code=401
		fi
		case "$_code" in
			200)
				# Do not leave an open session on the router.
				"$CURL" -s -m 5 -b "$_jar" -X DELETE -o /dev/null "$(router_url)/auth"
				rm -f "$LOGIN_FAILS"
				mkdir -p "$SESSIONS"
				_sid=$(random_hex)
				[ ${#_sid} = 32 ] || fail "не удалось создать сессию"
				echo "$_user" > "$SESSIONS/$_sid"
				HEADERS="Set-Cookie: $COOKIE=$_sid; Path=/; HttpOnly; SameSite=Strict"
				reply ok
				echo "вход: $_user"
				;;
			401|403)
				_n=$(cat "$LOGIN_FAILS" 2>/dev/null)
				case "$_n" in ''|*[!0-9]*) _n=0 ;; esac
				echo $((_n + 1)) > "$LOGIN_FAILS"
				sleep 2
				fail "неверный логин или пароль"
				;;
			*)
				fail "роутер не ответил на проверку пароля (ROUTER_URL в shin4static.conf)"
				;;
		esac
		exit 0
	fi
	if ! session_valid; then
		reply auth
		echo "нужен вход"
		exit 0
	fi
	if [ "$_a" = logout ]; then
		[ "$REQUEST_METHOD" = POST ] && [ "$(param t)" = "$TOKEN" ] || fail "неверный запрос"
		rm -f "$SESSIONS/$(session_id)"
		HEADERS="Set-Cookie: $COOKIE=; Path=/; HttpOnly; SameSite=Strict; Max-Age=0"
		reply ok
		echo "выход"
		exit 0
	fi
fi
_name=$(param name)
case "$_name" in
	''|isp.list|vpn1.list|vpn2.list) ;;
	*) fail "недопустимое имя файла" ;;
esac

if [ "$REQUEST_METHOD" = POST ]; then
	[ "$(param t)" = "$TOKEN" ] || fail "неверный токен: обновите страницу"
	case "$_a" in
		save)
			[ -n "$_name" ] || fail "не указан файл"
			case "$CONTENT_LENGTH" in
				''|*[!0-9]*) fail "нет данных" ;;
			esac
			[ "$CONTENT_LENGTH" -le "$MAX_BODY" ] || fail "файл больше $MAX_BODY байт"
			_base=$(param base)
			case "$_base" in *[!0-9a-f]*) _base= ;; esac
			[ ${#_base} = 32 ] || fail "нет версии файла: обновите страницу"
			mkdir -p "$LISTS"
			lock_dir "$LISTS/.save.lock" 30 || fail "файл сейчас сохраняется из другого окна, повторите"
			_tmp=
			trap 'rm -f "$_tmp"; rmdir "$LISTS/.save.lock" 2>/dev/null' EXIT
			# Another tab or an SSH edit changed the file after this page
			# loaded it: do not overwrite their changes.
			[ "$(cat "$LISTS/$_name" 2>/dev/null | md5sum | cut -d' ' -f1)" = "$_base" ] ||
				fail "$_name изменён на роутере после загрузки страницы. Скопируйте свои правки и обновите страницу."
			_tmp=$(mktemp "$LISTS/.$_name.XXXXXX") || fail "не удалось записать $_name"
			head -c "$CONTENT_LENGTH" | tr -d '\r' > "$_tmp" && chmod 644 "$_tmp" &&
				mv "$_tmp" "$LISTS/$_name" || fail "не удалось записать $_name"
			reply ok
			echo "сохранено: $_name"
			;;
		check) run_s4s check ;;
		apply) run_s4s update ;;
		*) fail "неизвестное действие" ;;
	esac
	exit 0
fi

case "$_a" in
	token)
		reply ok
		echo "$TOKEN"
		;;
	info)
		reply ok
		for _v in ISP VPN1 VPN2; do
			printf '%s=%s\n' "$_v" "$(conf_value "$_v")"
		done
		echo "WEB_AUTH=$WEB_AUTH"
		;;
	get)
		[ -n "$_name" ] || fail "не указан файл"
		[ -f "$LISTS/$_name" ] || fail "нет файла $_name"
		reply ok
		cat "$LISTS/$_name"
		;;
	status) run_s4s status ;;
	why)
		_ip=$(param ip)
		case "$_ip" in
			''|*[!0-9.]*) fail "укажите IPv4-адрес" ;;
		esac
		run_s4s why "$_ip"
		;;
	*) fail "неизвестное действие" ;;
esac
