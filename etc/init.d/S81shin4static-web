#!/bin/sh
# Shin4Static web interface: own lighttpd instance (renamed copy, own config,
# port and pid file). /opt/etc/lighttpd and S80lighttpd are not used.

R=${S4S_ROOT:-/opt}
PATH=$R/bin:$R/sbin:/sbin:/bin:/usr/sbin:/usr/bin
ETC=$R/etc/shin4static
CONF=$ETC/shin4static.conf
AUTH=$ETC/web.htdigest
LCONF=$ETC/lighttpd.conf
SHARE=$R/share/shin4static
HTTPD=$SHARE/sbin/s4s-lighttpd
PIDFILE=$R/var/run/shin4static-web.pid
TOKEN=$R/var/shin4static/web.token

WEB_LISTEN=
[ -f "$CONF" ] && . "$CONF"

running() {
	[ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null
}

write_config() {
	cat > "$LCONF" <<EOF
# Generated by S81shin4static-web from $CONF. Do not edit.
server.modules = ( "mod_auth", "mod_authn_file", "mod_cgi" )
server.document-root = "$SHARE/www"
server.bind = "${WEB_LISTEN%:*}"
server.port = ${WEB_LISTEN##*:}
server.pid-file = "$PIDFILE"
server.errorlog-use-syslog = "enable"
server.tag = ""
index-file.names = ( "index.html" )
dir-listing.activate = "disable"
mimetype.assign = (
	".html" => "text/html; charset=utf-8",
	".js" => "text/javascript; charset=utf-8",
	".css" => "text/css; charset=utf-8",
)
\$HTTP["url"] =~ "^/cgi-bin/" {
	cgi.assign = ( "" => "/bin/sh" )
}
auth.backend = "htdigest"
auth.backend.htdigest.userfile = "$AUTH"
auth.require = ( "/" => ( "method" => "basic", "realm" => "Shin4Static", "require" => "valid-user" ) )
EOF
}

start() {
	[ -n "$WEB_LISTEN" ] || { echo "WEB_LISTEN не задан в $CONF — веб-интерфейс выключен"; return 0; }
	[ -s "$AUTH" ] || { echo "нет файла паролей $AUTH — запустите install.sh"; return 1; }
	running && { echo "уже запущен"; return 0; }
	_src=$(command -v lighttpd 2>/dev/null)
	[ -x "$_src" ] || { echo "не найден lighttpd: opkg install lighttpd"; return 1; }
	# Keep the copy in step with the installed package and its modules.
	mkdir -p "$SHARE/sbin" "$(dirname "$PIDFILE")" "$(dirname "$TOKEN")"
	if ! cmp -s "$_src" "$HTTPD"; then
		cp "$_src" "$HTTPD.new" && chmod +x "$HTTPD.new" && mv "$HTTPD.new" "$HTTPD"
	fi
	write_config
	_test=$("$HTTPD" -tt -f "$LCONF" 2>&1) || { echo "ошибка в $LCONF: $_test"; return 1; }
	# New token on every start: open pages must reload.
	head -c 16 /dev/urandom | od -An -tx1 | tr -d ' \n' > "$TOKEN"
	"$HTTPD" -f "$LCONF" && echo "веб-интерфейс: http://$WEB_LISTEN/"
}

stop() {
	running && kill "$(cat "$PIDFILE")"
	rm -f "$PIDFILE"
}

case "$1" in
	start) start ;;
	stop|kill) stop ;;
	restart) stop; sleep 1; start ;;
	status) if running; then echo "запущен (pid $(cat "$PIDFILE"))"; else echo "не запущен"; fi ;;
	*) echo "Usage: $0 {start|stop|restart|status}" ;;
esac
